# {{type}}

## Description

{{{description}}}

## Usages

{{#if standalone~}}
This type is standalone and configured under the root key `{{prefix}}`.
{{else~}}
<div class="usages">
    <ul>
{{~#each usages}}
        <li><a href="{{this.type}}.md#{{this.key}}"><code>{{this.path}}</code></a></li>
{{~/each}}
    </ul>
</div>
{{~/if}}

## Configuration options

<table>
    <thead>
    <tr>
        <th>Key</th>
        <th>Type</th>
        <th>Allowed Values</th>
        <th>Default Value</th>
        <th>Description</th>
    </tr>
    </thead>
    <tbody>
{{~#each options}}
        <tr>
            <td id="{{this.key}}">
                <div><code>{{this.key}}</code></div>
{{~#if this.tags.length~}}
                    <div class="tags">
                        <ul>
{{~#each this.tags~}}
                                <li class="{{this}}">{{this}}</li>
{{~/each~}}
                        </ul>
                    </div>
{{~/if}}
            </td>
            <td>
                <div>
                    <a href="{{#if type.complex}}{{type.type}}.md{{else}}builtins.md#{{type.type}}{{/if}}">
{{~#if type.isValue}}
                        <code>{{type.type}}</code>
{{~/if}}
{{~#if type.isList}}
                        <code>List&lt;{{type.type}}&gt;</code>
{{~/if~}}
{{~#if type.isMap}}
                        <code>Map&lt;String,{{type.type}}&gt;</code>
{{~/if}}
                    </a>
                </div>
{{~#if providers.length}}
                <div class="providers">
                    Known providers:
                    <ul>
{{#each providers}}
                        <li>{{prefix}}: <a href="{{path}}">{{name}}</a></li>
{{~/each}}
                    </ul>
                </div>
{{~/if}}
            </td>
            <td>
{{~#if allowedValues.length}}
                <ul>
{{~#each allowedValues}}
                    <li><code>{{value}}</code> - <span>{{description}}</span></li>
{{~/each}}
                </ul>
{{~/if}}
            </td>
            <td>
{{~#if defaultValue}}
                <code>{{defaultValue}}</code>
{{~/if}}
            </td>
            <td>{{{description}}}</td>
        </tr>
{{~/each}}
    </tbody>
</table>
