# {{type}}

## Description

{{{description}}}

## Usages

{{#if standalone~}}
This config type is standalone and configured under the root key `{{prefix}}`.
{{~else~}}
{{~#if usages.length~}}
<ul class="usages">
{{~#each usages}}
    <li><a href="{{enclosingType}}.md#{{key}}"><code>{{path}}</code></a></li>
{{~/each}}
</ul>
{{~/if~}}
{{~/if}}

## Options

<table>
    <thead>
        <tr>
            <th>Key</th>
            <th>Type</th>
            <th>Description</th>
            <th>Flags</th>
            <th>Default Value</th>
            <th colspan="2">Allowed Values</th>
        </tr>
    </thead>
    <tbody>
{{~#each options}}
        <tr id="{{key}}">
            <td rowspan="{{rowspan}}"><code>{{key}}</code></td>
            <td rowspan="{{rowspan}}">
{{~#if type.resolved~}}
                <a href="{{type.fullName}}.md">
{{~/if~}}
{{~#if type.isValue~}}
                    <code>{{type.shortName}}</code>
{{~/if~}}
{{~#if type.isList~}}
                    <code>List&lt;{{type.shortName}}&gt;</code>
{{~/if~}}
{{~#if type.isMap~}}
                    <code>Map&lt;String,{{type.shortName}}&gt;</code>
{{~/if~}}
{{~#if type.resolved~}}
                </a>
{{~/if~}}
            </td>
            <td rowspan="{{rowspan}}">{{{description}}}</td>
            <td rowspan="{{rowspan}}">
{{~#if flags.length}}
                <ul>
{{~#each flags}}
                    <li>{{this}}</li>
{{~/each}}
                </ul>
{{~else~}}
-
{{~/if}}
            </td>
            <td rowspan="{{rowspan}}">
{{~#if defaultValue~}}
                <code>{{defaultValue}}</code>
{{~else~}}
-
{{~/if~}}
            </td>
{{~#if firstAllowedValue}}
            <td><code>{{firstAllowedValue.value}}</code></td>
            <td>
{{~#if firstAllowedValue.description~}}
{{{firstAllowedValue.description}}}
{{~else~}}
-
{{~/if~}}
            </td>
{{~else}}
            <td colspan="2">-</td>
{{~/if}}
        </tr>
{{~#each otherAllowedValues}}
        <tr>
            <td><code>{{value}}</code></td>
            <td>
{{~#if description~}}
{{{description}}}
{{~else~}}
-
{{~/if~}}
            </td>
        </tr>
{{~/each}}
{{~/each}}
    </tbody>
</table>
