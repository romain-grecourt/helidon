<rules>
    <rule if="${app-type} == 'custom'">
        <rule if="${media} != []">
            <!-- do not combine media and metrics -->
            <exclude if="${metrics}"/>

            <!-- do not combine docker and metrics -->
            <exclude if="${docker}" />

            <!-- do not combine media and security -->
            <exclude if="${security}" />
        </rule>
        <rule if="${security}">
            <!-- do not combine security and metrics -->
            <exclude if="${metrics}" />

            <!-- do not combine security and docker -->
            <exclude if="${docker}" />

            <!-- do not combine security and extra -->
            <exclude if="${extra} != []" />

            <!-- force single option for security.atn -->
            <rule if="${security.atz} == []">
                <exclude if="sizeof ${security.atn} != 1"/>
            </rule>

            <!-- only combine security.atz with security.atn=oidc -->
            <rule if="${security.atz} == ['abc']">
                <exclude if="${security.atn} != ['oidc']"/>
            </rule>
        </rule>
        <rule if="${docker}">

            <!-- do not combine docker and tracing -->
            <exclude if="${tracing}" />

            <!-- do not combine docker and extra -->
            <exclude if="${extra} != []" />
        </rule>

        <!-- do not combine custom and db -->
        <exclude if="${db}" />

        <!-- restrict multi-module -->
        <rule if="${multi-module}">
            <exclude if="${flavor} != 'se'"/>
            <exclude if="${extra} != []"/>
            <exclude if="${db}"/>
            <exclude if="${security}" />
            <exclude if="${metrics}" />
            <exclude if="${tracing}" />
            <exclude if="${health}" />
            <exclude if="${docker}" />
            <exclude if="${k8s}" />
            <exclude if="${jpms}" />
            <exclude if="${media} != ['json']"/>
            <rule if="${media} == ['json']">
                <exclude if="${media.json-lib} != 'jsonp"/>
            </rule>
        </rule>
    </rule>
    <rule if="${app-type} == 'database'">
        <rule if="${db.auto-ddl}">

            <!-- do not combine jackson and auto-ddl -->
            <exclude if="${media.json-lib} == 'jackson'"/>
        </rule>
        <rule if="${db.cp} == 'hikaricp'">

            <!-- do not combine jackson and hikaricp -->
            <exclude if="${media.json-lib} == 'jackson'"/>
        </rule>

        <!-- do not combine app-type=database and health -->
        <exclude if="${health}" />
    </rule>
</rules>
